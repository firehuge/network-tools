<config version="11.1.0" urldb="paloaltonetworks" detail-version="11.1.4">
  <!-- Synthetic: two internet circuits. ISP-A carries the default route; provider-assigned 198.51.100.0/27 is routed back to
       ISP-B with a more-specific static (one default per virtual router), so inbound traffic to it arrives on ISP-B. -->
  <shared></shared>
  <devices><entry name="localhost.localdomain"><network><interface><ethernet><entry name="ethernet1/1"><layer3><ip><entry name="203.0.113.2/29"/></ip></layer3></entry><entry name="ethernet1/2"><layer3><ip><entry name="192.0.2.2/30"/></ip></layer3></entry><entry name="ethernet1/3"><layer3><ip><entry name="172.16.10.1/24"/></ip></layer3></entry><entry name="ethernet1/4"><layer3><ip><entry name="10.20.0.1/24"/></ip></layer3></entry></ethernet></interface><virtual-router><entry name="default"><interface><member>ethernet1/1</member><member>ethernet1/2</member><member>ethernet1/3</member><member>ethernet1/4</member></interface><routing-table><ip><static-route><entry name="default-isp-a"><nexthop><ip-address>203.0.113.1</ip-address></nexthop><interface>ethernet1/1</interface><metric>10</metric><destination>0.0.0.0/0</destination></entry><entry name="pub27-isp-b"><nexthop><ip-address>192.0.2.1</ip-address></nexthop><interface>ethernet1/2</interface><metric>10</metric><destination>198.51.100.0/27</destination></entry></static-route></ip></routing-table></entry></virtual-router></network><deviceconfig><system><hostname>fw-edge-2isp</hostname></system></deviceconfig><vsys><entry name="vsys1"><import><network><interface><member>ethernet1/1</member><member>ethernet1/2</member><member>ethernet1/3</member><member>ethernet1/4</member></interface></network></import><zone><entry name="isp-a-untrust"><network><layer3><member>ethernet1/1</member></layer3></network></entry><entry name="isp-b-untrust"><network><layer3><member>ethernet1/2</member></layer3></network></entry><entry name="dmz"><network><layer3><member>ethernet1/3</member></layer3></network></entry><entry name="trust"><network><layer3><member>ethernet1/4</member></layer3></network></entry></zone><address><entry name="vip-b-web"><ip-netmask>198.51.100.10</ip-netmask></entry><entry name="vip-a-app"><ip-netmask>198.51.100.70</ip-netmask></entry><entry name="dmz-web"><ip-netmask>172.16.10.20</ip-netmask></entry><entry name="dmz-app"><ip-netmask>172.16.10.30</ip-netmask></entry><entry name="trust-net"><ip-netmask>10.20.0.0/24</ip-netmask></entry></address><rulebase><security><rules><entry name="in-web-b"><to><member>dmz</member></to><from><member>isp-b-untrust</member></from><source><member>any</member></source><destination><member>vip-b-web</member></destination><source-user><member>any</member></source-user><category><member>any</member></category><application><member>any</member></application><service><member>service-https</member></service><action>allow</action></entry><entry name="in-app-a"><to><member>dmz</member></to><from><member>isp-a-untrust</member></from><source><member>any</member></source><destination><member>vip-a-app</member></destination><source-user><member>any</member></source-user><category><member>any</member></category><application><member>any</member></application><service><member>service-https</member></service><action>allow</action></entry><entry name="trust-out"><to><member>isp-a-untrust</member><member>isp-b-untrust</member></to><from><member>trust</member></from><source><member>trust-net</member></source><destination><member>any</member></destination><source-user><member>any</member></source-user><category><member>any</member></category><application><member>any</member></application><service><member>service-https</member></service><action>allow</action></entry></rules></security><nat><rules><entry name="dnat-web-b"><destination-translation><translated-address>dmz-web</translated-address></destination-translation><to><member>isp-b-untrust</member></to><from><member>isp-b-untrust</member></from><source><member>any</member></source><destination><member>vip-b-web</member></destination><service>any</service></entry><entry name="dnat-app-a"><destination-translation><translated-address>dmz-app</translated-address></destination-translation><to><member>isp-a-untrust</member></to><from><member>isp-a-untrust</member></from><source><member>any</member></source><destination><member>vip-a-app</member></destination><service>any</service></entry></rules></nat></rulebase></entry></vsys></entry></devices>
</config>
